# 必填：PostgreSQL 与 NextAuth
DATABASE_URL="postgresql://modelhub:modelhub@localhost:5432/modelhub?schema=public"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="请使用 openssl rand -base64 32 生成至少32位随机字符串"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# 可选：未配置时自动使用进程内限流、数据库搜索、本地文件存储
REDIS_URL="redis://localhost:6379"
MEILISEARCH_HOST="http://localhost:7700"
MEILISEARCH_API_KEY="masterKey"
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="modelhub"
S3_ACCESS_KEY_ID="modelhub"
S3_SECRET_ACCESS_KEY="modelhub123"
S3_PUBLIC_URL="http://localhost:9000/modelhub"
S3_FORCE_PATH_STYLE="true"

# 仅执行种子时使用；生产环境必须替换为强密码
SEED_PASSWORD="Demo123456"

# 上传限制（Vercel 通过 S3 浏览器直传，不受函数 4.5MB 限制）
MAX_IMAGE_SIZE_MB="5"
MAX_MODEL_FILE_SIZE_MB="100"
ALLOWED_MODEL_EXTENSIONS=".zip,.rar,.7z,.blend,.obj,.fbx,.glb,.gltf,.stl,.safetensors,.ckpt,.pt,.pth,.onnx"
